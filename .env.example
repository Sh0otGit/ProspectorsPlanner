# Copy to .env and fill in real values. There is no default password --
# the server refuses admin logins without ADMIN_PASSWORD set.

# Shared admin password (single-operator tool, not per-user accounts).
ADMIN_PASSWORD=

# Port the server listens on. Optional, defaults to 8420.
PORT=8420

# Directory for the SQLite database. Optional -- defaults to a file next to
# scrapers/data/lode.db for local dev. Set this to a mounted persistent
# disk's path when hosting (e.g. Render's default /var/data) so the
# database survives restarts and redeploys.
DB_DIR=

# Set to "1" to serve the maintenance page for all public/admin routes
# instead of the normal site. Optional.
MAINTENANCE_MODE=
